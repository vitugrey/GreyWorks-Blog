# Ambiente: development | production
APP_ENV=development
SITE_TITLE=GreyWorks Blog
SITE_URL=http://127.0.0.1:8000
SITE_DESCRIPTION=Notas minimalistas sobre Tecnologia, cultura Geek e Off-Topic por Vitor Grey.

# Banco de dados (local: SQLite | VPS Docker: PostgreSQL via docker-compose)
DATABASE_URL=sqlite:///./greyworks.db
# Exemplo PostgreSQL (VPS):
# DATABASE_URL=postgresql+psycopg://greyworks_app:TROQUE_POR_SENHA_FORTE@db:5432/greyworks_blog

# Seguranca (OBRIGATORIO definir valores criptograficos fortes em producao!)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
API_TOKEN=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Credenciais iniciais de bootstrap do admin (usado apenas se nenhum admin existir no banco)
# Em producao, prefira criar via CLI: python -m app.cli create-admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# PostgreSQL (usado pelo docker-compose.yml na VPS)
POSTGRES_DB=greyworks_blog
POSTGRES_USER=greyworks_app
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# Dominio publico da VPS (usado pelo Caddy para HTTPS automatico Let's Encrypt)
BLOG_DOMAIN=blog.seudominio.com.br
